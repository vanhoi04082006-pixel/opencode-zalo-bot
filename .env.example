ZALO_GROUP_ID=
AI_PREFIX=AI:
# Account mode: auto (bot creds file exists = dual, else single), single, dual
ZALO_MODE=auto
# Dedicated bot account (dual mode). Leave unset + no file = single shared account.
ZALO_BOT_CREDS_PATH=.zalo-creds-bot.json
ZALO_BOT_QR_PATH=zalo-qr-bot.png
# CSV of group/DM ids the bot listens to. Empty = listen to all groups + DMs.
ZALO_ALLOWED_THREADS=
# Owner whitelist (dual mode, REQUIRED): sender uids allowed to control the bot.
# Empty in dual = fail-closed (bot ignores everyone). Single mode ignores it.
ZALO_OWNER_IDS=
OPENCODE_URL=http://127.0.0.1:4096
OPENCODE_WORKDIR=E:\
MAX_FILE_MB=1024
FILE_NOTIFY_MB=20
EXTRA_ROOTS=C:\Users\buiva\AppData\Local\Temp\opencode
INDEX_ROOTS=E:\;C:\Users\buiva
